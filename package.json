{
  "name": "tv",
  "productName": "TV",
  "version": "1.0.0",
  "private": true,
  "description": "Lecteur IPTV local pour abonnement Xtream Codes : chaînes, films, séries, guide des programmes et replay",
  "author": "xrousset78800",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "app": "node scripts/electron.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.5.20"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.xrousset.tv",
    "productName": "TV",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "lib/**",
      "public/**",
      "electron/**",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "TV-Setup-${version}.${ext}",
      "shortcutName": "TV",
      "deleteAppDataOnUninstall": false
    }
  }
}
