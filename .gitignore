# Dépendances
node_modules/

# Installateur généré (npm run dist)
dist/

# Playlists : elles contiennent les identifiants de l'abonnement dans chaque URL
*.m3u
*.m3u8

# Identifiants extraits de la playlist
config.json

# Clé TMDB (fournie au build par le secret GitHub TMDB_KEY)
tmdb.key

# Clé OpenSubtitles (fournie au build par le secret GitHub OPENSUBTITLES_KEY)
opensubtitles.key

# Base locale (recréée par l'import)
tv.db
tv.db-*

# Hébergement OVH (non utilisé par l'appli)
.ovhconfig

# Système / éditeur
.DS_Store
Thumbs.db
.vscode/
*.log

# Appli Android TV : fichiers de build
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/public/
*.keystore
*.jks
